# FitGear Pakistan - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

PORT=3000
NODE_ENV=development
DB_PATH=fitgear.sqlite
SESSION_SECRET=fitgear_pk_super_secret_session_2026

# Default Administrator Credentials
ADMIN_NAME=Admin FitGear
ADMIN_EMAIL=admin@fitgear.pk
ADMIN_PASSWORD=admin123

# Optional: Pakistani Payment Gateway Integration
# Real credentials from JazzCash Corporate Portal (https://www.jazzcash.com.pk/)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/api/payment/callback/jazzcash

# Real credentials from Telenor EasyPaisa Merchant Portal
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/api/payment/callback/easypaisa

# Optional: SMTP Server for Outbound Inquiry Emails
# (When empty, inquiries are saved securely in SQLite database table 'inquiries' for staff review)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=info@fitgear.pk
