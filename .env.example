# ==============================================================================
# FitGear Pakistan - Environment Configuration Template
# For Local Development: Copy this file to .env
# For Netlify: Set these variables in Site Configuration > Environment Variables
# ==============================================================================

PORT=3000
NODE_ENV=production
# In Netlify Functions, leave DB_PATH empty to auto-use /tmp/fitgear.sqlite
DB_PATH=fitgear.sqlite

# Remote Turso LibSQL Cloud Database (Recommended for Netlify Serverless Persistence)
# When configured, backend/db.js automatically connects via @libsql/client
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

SESSION_SECRET=fitgear_pk_super_secret_session_2026

# Default Administrator Credentials
ADMIN_NAME=Admin FitGear
ADMIN_EMAIL=admin@fitgear.pk
ADMIN_PASSWORD=admin123

# Node Runtime for Netlify (auto-configured via netlify.toml & .nvmrc)
NODE_VERSION=22

# Optional: Pakistani Payment Gateway Integration
# Real credentials from JazzCash Corporate Portal (https://www.jazzcash.com.pk/)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# In Production on Netlify: https://<your-site-name>.netlify.app/api/payment/callback/jazzcash
JAZZCASH_RETURN_URL=https://fitgear-pk.netlify.app/api/payment/callback/jazzcash

# Real credentials from Telenor EasyPaisa Merchant Portal
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# In Production on Netlify: https://<your-site-name>.netlify.app/api/payment/callback/easypaisa
EASYPAISA_RETURN_URL=https://fitgear-pk.netlify.app/api/payment/callback/easypaisa

# Optional: SMTP Server for Outbound Inquiry Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=info@fitgearpakistan.com
